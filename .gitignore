# Env / secrets — ignore every .env* everywhere (backend/.env,
# backend/.env.pythonanywhere, root .env.local, …). Only *.example files
# are tracked so deployment templates stay in the repo.
.env
.env.*
!*.example
!**/.env.example
!**/.*.env.example

