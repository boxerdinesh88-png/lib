# Phahendra Babu Library environment configuration (copy to .env and fill in your values)
#
# Email / SMTP — booking confirmations are sent with these.
# With Gmail, use an App Password (https://myaccount.google.com/apppasswords),
# NOT your regular password. Leave EMAIL_HOST_USER empty to log emails to the
# console instead of sending (handy for local dev).
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Phahendra Babu Library <PhahendraBabulibrary@gmail.com>

# Frontend URL used in email links
FRONTEND_URL=http://localhost:3000

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True only when the app runs behind a reverse proxy you control
# (otherwise clients can spoof the X-Forwarded-For IP used for audit/limits)
DJANGO_TRUST_XFF=False

# API
DJANGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payments (optional; leave empty to use the local mock gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_MOCK_PAYMENTS=True
